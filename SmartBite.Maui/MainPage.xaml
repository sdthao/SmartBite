<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartBite.Maui.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:sfButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:sfTabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             xmlns:sfPicker="clr-namespace:Syncfusion.Maui.Toolkit.Picker;assembly=Syncfusion.Maui.Toolkit"
             xmlns:sfProgressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="SmartBite.Maui.MainPage">

    <VerticalStackLayout>
        <!-- Main -->
        <VerticalStackLayout Padding="5">
            <StackLayout Spacing="10">
                <!-- Top Section with Avatar, Name, and Settings -->
                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Spacing="10">
                    <!-- Avatar -->
                    <sfCore:SfAvatarView ContentType="AvatarCharacter" AvatarCharacter="Avatar1"
                                         VerticalOptions="Center" HorizontalOptions="Center"
                                         Background="#588157" WidthRequest="50" HeightRequest="50" CornerRadius="25" />
                
                    <!-- TODO: Resize to fit on screen if name size is too long -->
                    <Label Text="{Binding GreetingMessage}" VerticalOptions="Center"
                           FontSize="20" FontAttributes="Bold"/>

                    <!-- Date Picker -->
                    <StackLayout Orientation="Horizontal" HorizontalOptions="EndAndExpand" VerticalOptions="Center">
                        <Frame CornerRadius="12" HeightRequest="40" WidthRequest="100" Padding="0">
                            <DatePicker Grid.ColumnSpan="2" Date="{Binding SelectedDate, Mode=TwoWay}"
                                        FontSize="Caption"/>
                        </Frame>
                        
                    </StackLayout>
                </StackLayout>

                <!-- Widget -->
                <StackLayout Orientation="Horizontal">
                    <Frame Padding="10" CornerRadius="20" HeightRequest="210"
                           VerticalOptions="Center" HorizontalOptions="FillAndExpand" >
                        
                        <sfTabView:SfTabView x:Name="sfTabView" TabBarPlacement="Bottom" TabBarHeight="25" 
                                             TabWidthMode="SizeToContent" EnableSwiping="True" TabHeaderPadding="140">
                            <sfTabView:SfTabView.Items>
                                <!-- Energy Summary -->
                                <sfTabView:SfTabItem Header="." TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}">
                                    <sfTabView:SfTabItem.Content>
                                        <Grid RowDefinitions="auto, auto">
                                            <!-- Energy Summary Label -->
                                            <Label Grid.Row="0" Text="Energy Summary" FontSize="15"
                                                   FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*, *" VerticalOptions="Start">
                                                <StackLayout Grid.Column="0" Orientation="Vertical" VerticalOptions="Start" Spacing="-10">
                                                    <!-- Daily Intake Progress Bar -->
                                                    <sfProgressBar:SfCircularProgressBar Progress="91"
                                                                                         HeightRequest="130" StartAngle="150" EndAngle="390"
                                                                                         ProgressFill="#c2e812"
                                                                                         ProgressThickness="15" ProgressRadiusFactor="10"
                                                                                         ProgressCornerStyle="BothCurve"
                                                                                         TrackThickness="15" TrackRadiusFactor="10"
                                                                                         TrackCornerStyle="BothCurve"
                                                                                         HorizontalOptions="Center" VerticalOptions="Center"
                                                                                         BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                                                        <sfProgressBar:SfCircularProgressBar.Content>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition />
                                                                    <RowDefinition />
                                                                </Grid.RowDefinitions>
                                                                <Label Text="1820"
                                                                       FontSize="20" FontAttributes="Bold"
                                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="End"/>
                                                                <Label Grid.Row="1"
                                                                       FontSize="15" Text="kCal"
                                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Start"/>
                                                            </Grid>
                                                        </sfProgressBar:SfCircularProgressBar.Content>
                                                    </sfProgressBar:SfCircularProgressBar>
                                                    <!-- Daily Inake Label -->
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                                                        <Image mi:MauiIcon.Value="{mi:MaterialOutlined Icon=ElectricBolt}"
                                                               HeightRequest="15"  />
                                                        <Label Text="Daily Intake" FontSize="15" />
                                                    </StackLayout>
                                                </StackLayout>
                                                <StackLayout Grid.Column="1" Orientation="Vertical" VerticalOptions="Start" Spacing="-10">
                                                    <!-- Daily Expenditure Progress Bar -->
                                                    <sfProgressBar:SfCircularProgressBar Progress="75"
                                                                                         StartAngle="150" EndAngle="390" HeightRequest="130"
                                                                                         ProgressFill="#eb5e28"
                                                                                         ProgressThickness="15" ProgressRadiusFactor="10"
                                                                                         ProgressCornerStyle="BothCurve"
                                                                                         TrackThickness="15" TrackRadiusFactor="10"
                                                                                         TrackCornerStyle="BothCurve"
                                                                                         HorizontalOptions="Center" VerticalOptions="Center"
                                                                                         BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                                                        <sfProgressBar:SfCircularProgressBar.Content>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition />
                                                                    <RowDefinition />
                                                                </Grid.RowDefinitions>
                                                                <Label Text="400"
                                                                       FontSize="20" FontAttributes="Bold"
                                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="End"/>
                                                                <Label Grid.Row="1"
                                                                       FontSize="15" Text="kCal"
                                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Start"/>
                                                            </Grid>
                                                        </sfProgressBar:SfCircularProgressBar.Content>
                                                    </sfProgressBar:SfCircularProgressBar>
                                                    <!-- Daily Inake Label -->
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                                                        <Image mi:MauiIcon.Value="{mi:MaterialOutlined Icon=FitnessCenter}"
                                                               HeightRequest="15"  />
                                                        <Label Text="Expenditure" FontSize="15" />
                                                    </StackLayout>
                                                </StackLayout>
                                            </Grid>

                                        </Grid>
                                    </sfTabView:SfTabItem.Content>
                                </sfTabView:SfTabItem>

                                <!-- Macro Summary -->
                                <sfTabView:SfTabItem Header="." TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}">
                                    <sfTabView:SfTabItem.Content>
                                        <Grid RowDefinitions="auto, auto">
                                            <!-- Macro Summary Label -->
                                            <Label Grid.Row="0" Text="Macro Summary" FontSize="15"
                                                   FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <!-- Macros Progress Bars -->
                                            <StackLayout Grid.Row="1" Orientation="Vertical" Margin="10, 10" Spacing="5">
                                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                                                        <Label Text="Calorie Goal - 1820/2000 kcal" FontSize="13"/>
                                                        <Label Text="91%" FontSize="13" HorizontalOptions="EndAndExpand"/>
                                                    </StackLayout>
                                                    <sfProgressBar:SfLinearProgressBar Progress="91" ProgressFill="#c2e812"
                                                                                       ProgressHeight="10" ProgressCornerRadius="20"
                                                                                       TrackCornerRadius="20" TrackHeight="10"/>
                                                </StackLayout>
                                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                                                        <Label Text="Protein - 135/150g" FontSize="13"/>
                                                        <Label Text="90%" FontSize="13" HorizontalOptions="EndAndExpand"/>
                                                    </StackLayout>
                                                    <sfProgressBar:SfLinearProgressBar Progress="90" ProgressFill="#2d728f"
                                                                                       ProgressHeight="10" ProgressCornerRadius="20"
                                                                                       TrackCornerRadius="20" TrackHeight="10"/>
                                                </StackLayout>
                                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                                                        <Label Text="Carbohydrates - 200/200g" FontSize="13"/>
                                                        <Label Text="100%" FontSize="13" HorizontalOptions="EndAndExpand"/>
                                                    </StackLayout>
                                                    <sfProgressBar:SfLinearProgressBar Progress="100" ProgressFill="#FFC914"
                                                                                       ProgressHeight="10" ProgressCornerRadius="20"
                                                                                       TrackCornerRadius="20" TrackHeight="10"/>
                                                </StackLayout>
                                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                                                        <Label Text="Fats - 42/60g" FontSize="13"/>
                                                        <Label Text="70%" FontSize="13" HorizontalOptions="EndAndExpand"/>
                                                    </StackLayout>
                                                    <sfProgressBar:SfLinearProgressBar Progress="70" ProgressFill="#6a4c93"
                                                                                       ProgressHeight="10" ProgressCornerRadius="20"
                                                                                       TrackCornerRadius="20" TrackHeight="10"/>
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </sfTabView:SfTabItem.Content>
                                </sfTabView:SfTabItem>
                            </sfTabView:SfTabView.Items>
                        </sfTabView:SfTabView>

                    </Frame>
                </StackLayout>

                <!-- Food List View -->
                <ScrollView>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                        <Frame Padding="20" CornerRadius="20" HeightRequest="390"
                               VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <CollectionView ItemsSource="{Binding FoodItems}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                                            <StackLayout VerticalOptions="FillAndExpand">
                                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Spacing="50">
                                                    <Image mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Fastfood, IconColor=#e36414}"
                                                           WidthRequest="25" HeightRequest="25"
                                                           VerticalOptions="Center" HorizontalOptions="Center"/>
                                                    <StackLayout Orientation="Vertical" VerticalOptions="FillAndExpand">
                                                        <Label Text="{Binding Name}" FontAttributes="Bold" 
                                                               HorizontalOptions="Start" VerticalOptions="Center"/>
                                                        <Label Text="{Binding Weight}"
                                                               HorizontalOptions="Start" VerticalOptions="Center"/>
                                                    </StackLayout>
                                                    <Label Text="{Binding Calories}" FontAttributes="Bold" 
                                                           HorizontalOptions="EndAndExpand" VerticalOptions="Center"/>
                                                </StackLayout>
                                                <BoxView HeightRequest="1" HorizontalOptions="FillAndExpand" VerticalOptions="End"
                                                         BackgroundColor="{AppThemeBinding Light={StaticResource DarkBackground}, Dark={StaticResource LightBackground}}"/>
                                            </StackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Frame>
                    </StackLayout>
                </ScrollView>
                
            </StackLayout>
        </VerticalStackLayout>

        <!-- Footer -->
        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">

            <!-- AI Tool -->
            <ImageButton mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Insights, 
                         IconColor={AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}}"
                         Command="{Binding AIToolCommand}"
                         HorizontalOptions="CenterAndExpand"
                         VerticalOptions="CenterAndExpand"
                         HeightRequest="30"
                         BackgroundColor="Transparent"/>

            <!-- Journal -->
            <ImageButton mi:MauiIcon.Value="{mi:MaterialOutlined Icon=Book, 
                         IconColor={AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}}"
                         Command="{Binding JournalCommand}"
                         HorizontalOptions="CenterAndExpand"
                         VerticalOptions="CenterAndExpand"
                         HeightRequest="30" 
                         BackgroundColor="Transparent">
            </ImageButton>

            <!-- Add Food Item -->
            <ImageButton mi:MauiIcon.Value="{mi:MaterialOutlined Icon=AddCircle, 
                         IconColor={AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}}"
                         Command="{Binding EditFoodCommand}"
                         HorizontalOptions="CenterAndExpand"
                         VerticalOptions="CenterAndExpand"
                         HeightRequest="30" 
                         BackgroundColor="Transparent"/>

            <!-- Camera -->
            <ImageButton mi:MauiIcon.Value="{mi:MaterialOutlined Icon=CameraAlt, 
                         IconColor={AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}}"
                         Command="{Binding CameraCommand}"
                         HorizontalOptions="CenterAndExpand"
                         VerticalOptions="CenterAndExpand"
                         HeightRequest="30" 
                         BackgroundColor="Transparent"/>

            <!-- More Options -->
            <ImageButton mi:MauiIcon.Value="{mi:MaterialOutlined Icon=MoreHoriz, 
                         IconColor={AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimaryLightText}}}"
                         Command="{Binding MoreOptionsCommand}"
                         HorizontalOptions="CenterAndExpand"
                         VerticalOptions="CenterAndExpand"
                         HeightRequest="30" 
                         BackgroundColor="Transparent"/>
        </StackLayout>
    </VerticalStackLayout>
    

</ContentPage>
